{
  "name": "@citadel/backend",
  "version": "0.0.1",
  "description": "A simple and secure password manager. (Backend)",
  "main": "index.js",
  "type": "module",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --write"
    ]
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "postbuild": "tsc-alias -p tsconfig.json",
    "tsc": "tsc",
    "test": "vitest",
    "prepare": "husky",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit --watch",
    "create-opaque-setup": "tsx src/utils/createOpaqueSetup.ts"
  },
  "keywords": [
    "password",
    "backend",
    "express",
    "typescript",
    "nodejs",
    "mongodb",
    "redis",
    "password manager"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.15.0",
  "dependencies": {
    "@felix-kyun/file-router": "^1.1.3",
    "@redis/client": "^5.10.0",
    "@serenity-kit/opaque": "^0.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.23.0",
    "nodemailer": "^7.0.13",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.3",
    "redis": "^5.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.13",
    "@types/nodemailer": "^7.0.9",
    "@types/supertest": "^6.0.3",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.8.16",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
